# IDE
.idea/

# Maven build output (all modules)
**/target/

# npm dependencies (generated by npm install during build)
**/node_modules/

# Bower dependencies (generated by bower install during build)
**/bower_components/

# Frontend build output (generated by npm run build / grunt)
docdoku-plm-front/dist/
docdoku-plm-front/app/**/main.css

# Lock files（npm 安装时因环境差异自动升级，不入库）
/package-lock.json
docdoku-plm-front/package-lock.json

# Runtime files created by start.sh / Docker (not in version control)
docdoku-plm-docker/keystore
docdoku-plm-docker/data/

# SSL 私钥（钥匙不入库，证书/公钥可以保留）
docdoku-plm-docker/proxy/ssl/*.key

# OpenCode / Playwright 工具目录（本地运行产生，非项目代码）
.playwright-mcp/
.sisyphus/

# 根目录临时截图文件
/*.png
/*.jpg
/*.jpeg


# Migration backup files (generated by migrate.sh export)
docdoku-plm-docker/backup_db.sql
docdoku-plm-docker/backup_vault.tar.gz
